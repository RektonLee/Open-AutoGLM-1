[
  {
    "name": "TodoWrite",
    "description": "Track multi-step tasks (3+). Skip trivial.\nStates: pending,in_progress,completed. Only ONE in_progress.\ncontent=imperative; activeForm=present continuous.\nComplete only if fully successful; if blocked keep in_progress and add subtask.",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "todos": {
          "type": "array",
          "description": "todo list",
          "items": {
            "type": "object",
            "properties": {
              "content": { "type": "string", "minLength": 1 },
              "status": {
                "type": "string",
                "enum": ["pending", "in_progress", "completed"]
              },
              "activeForm": { "type": "string", "minLength": 1 }
            },
            "required": ["content", "status", "activeForm"],
            "additionalProperties": false
          }
        }
      },
      "required": ["todos"],
      "additionalProperties": false
    }
  },
  {
    "name": "Skill",
    "description": "Execute domain skill (/commit etc). Must call FIRST, not text.\nSkip call if <command-name> tag already present.\nSkills: wifi,calendar,sms,camera,gallery,contacts,audio,screen,bluetooth,battery,clock.",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "skill": { "type": "string", "description": "skill name" },
        "args": { "type": "string", "description": "optional args" }
      },
      "required": ["skill"],
      "additionalProperties": false
    }
  },
  {
